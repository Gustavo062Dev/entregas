# Node.js 24. Copie para .env (ignorado pelo Git) e preencha antes da primeira execução.
ROTA_ADMIN_EMAIL=
ROTA_ADMIN_PASSWORD=
ROTA_ADMIN_NAME=Administrador
DATABASE_PATH=.local/data/rota.sqlite
HOST=127.0.0.1
PORT=3001

# Desenvolvimento: 1 carrega entregas fictícias e permite avançar a simulação.
# Use somente em um banco novo e separado; o padrão 0 inicia a operação vazia.
API_DEMO_SEED=0
ROTA_DEMO_DRIVER_PASSWORD=

# Servidor de produção: serve dist/ junto da API. Configure HTTPS no proxy reverso.
NODE_ENV=development

# Para Android, inclua https://localhost. Múltiplas origens exatas separadas por vírgula.
ROTA_ALLOWED_ORIGINS=

# URL HTTPS da central usada no build Android (não é segredo). Web usa a mesma origem.
VITE_API_URL=

# Mapa geográfico: vazio usa OpenStreetMap. Configure um provedor HTTPS para a operação.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
